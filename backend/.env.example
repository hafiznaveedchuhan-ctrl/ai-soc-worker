# .env.example — variable NAMES only (constitution Art. III). Copy to backend/.env and fill
# the values yourself. Never commit .env. Grouped by the service that reads each variable;
# names may be refined by the feature that introduces them.

# ---------------------------------------------------------------- all Agents SDK processes
# Not a secret: keeps raw prompts/tool data out of traces exported to OpenAI (plan A2). Keep 0.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0

# ---------------------------------------------------------------- agent-service (features 05–07)
# OpenAI key (rotate if it was ever pasted anywhere)
OPENAI_API_KEY=
# Default model for every agent (smallest current OpenAI model, ADR-0003)
AGENT_MODEL_DEFAULT=
# Per-run budget guard in USD
AGENT_RUN_BUDGET_USD=
# Total LLM budget in USD (hard cap 10)
AGENT_TOTAL_BUDGET_USD=
# Handbook MCP endpoint (Naveed runs `npm run serve` in ../handbook)
HANDBOOK_MCP_URL=
# Free-tier web search API key (ADR-0004)
WEB_SEARCH_API_KEY=

# ---------------------------------------------------------------- wazuh-mcp (feature 03)
# fixture | live
WAZUH_MODE=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# ---------------------------------------------------------------- enrichment-mcp (feature 03)
ABUSEIPDB_API_KEY=

# ---------------------------------------------------------------- api-gateway (feature 08)
# Neon database soc_worker (Naveed creates it)
SOC_DB_URL=
# Fernet key that encrypts mask_map rows
MASK_MAP_KEY=
# auth0 | dev  (dev works only when ENV=local)
AUTH_MODE=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
CORS_ORIGINS=
# shared secret between api-gateway and agent-service (internal network)
AGENT_INTERNAL_TOKEN=
